[Unit]
Description=Radacleaner - daily NAZK declarations sync + company sector classification
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=radamon
WorkingDirectory=/home/radamon/radacleaner
ExecStart=/home/radamon/radacleaner/venv/bin/python sync_nazk_declarations.py
ExecStart=/home/radamon/radacleaner/venv/bin/python -u enrich_company_sectors.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=7200
