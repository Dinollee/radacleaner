[Unit]
Description=Radacleaner — EU alignment score calculation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=radamon
WorkingDirectory=/home/radamon/radacleaner
ExecStart=/home/radamon/radacleaner/venv/bin/python eu_alignment.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800
