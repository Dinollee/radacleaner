[Unit]
Description=Radacleaner Daily Digest - send daily summary to Telegram
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/radamon/radacleaner
ExecStart=/home/radamon/radacleaner/venv/bin/python monitor.py --daily
StandardOutput=journal
StandardError=journal
TimeoutStartSec=60
