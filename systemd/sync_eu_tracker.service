[Unit]
Description=Radacleaner — EU cluster news monitoring + Telegram alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=radamon
WorkingDirectory=/home/radamon/radacleaner
ExecStart=/home/radamon/radacleaner/venv/bin/python sync_eu_tracker.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300