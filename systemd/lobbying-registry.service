[Unit]
Description=Radacleaner — daily NAZK lobbying registry sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=radamon
WorkingDirectory=/home/radamon/radacleaner
ExecStart=/home/radamon/radacleaner/venv/bin/python sync_lobbying_registry.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=1800
