[Unit]
Description=Radacleaner Daily LLM Digest - Deterministic daily summary (no LLM)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/radamon/radacleaner
ExecStart=/home/radamon/radacleaner/venv/bin/python daily_digest_llm.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=120
