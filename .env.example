# radacleaner — Конфігурація
# Скопіюйте в .env та заповніть своїми даними

# === Database (PostgreSQL) ===
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=my_bills
DB_USER=hermes
DB_PASSWORD=your_db_password_here

# === Groq LLM ===
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# === Telegram ===
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# === Cloudflare (для майбутньої міграції) ===
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# === Логування ===
LOG_LEVEL=INFO